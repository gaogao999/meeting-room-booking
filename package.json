{
  "name": "meeting-room-booking",
  "version": "2.4.1",
  "description": "Book the company's meeting rooms",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:deploy": "prisma migrate deploy && node scripts/apply-guards.js",
    "db:push": "prisma db push && node scripts/apply-guards.js",
    "db:guards": "node scripts/apply-guards.js",
    "check:graph": "node scripts/check-graph.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
