# ===== データベース（SQL Server）=====
# KAGA サーバーの SQL Server に接続する。IT 部門から接続情報を受け取ること。
# encrypt / trustServerCertificate は社内の証明書の扱いに合わせて調整する。
DATABASE_URL="sqlserver://SERVER:1433;database=meeting_room_booking;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true"

# ===== サーバ設定 =====
PORT=3000
# Express 自身が参照する。本番は production
NODE_ENV=development
# リバースプロキシ経由で公開する場合のみ有効にする。
# 予約時に記録する IP を、プロキシではなく利用者のものにするための設定。
# プロキシがいないのに有効にすると、IP を自由に詐称できてしまうため既定は無効。
#TRUST_PROXY=1

# ===== 認証 =====
# mock      : ログインなし。予約時に部署と氏名を入力する（ブラウザが記憶する）
# checklogin: 既存のログインを利用する
AUTH_MODE=mock

# ===== Outlook のカレンダー連携（参加者の空き時間表示）=====
# IT 部門が Azure AD にアプリを登録し、管理者承認を行うと以下が発行される。
# 4つすべてが揃うまでは、画面には「サンプル」と明示された仮の予定が表示される。
# 必要な権限: Calendars.Read（空き時間の参照）
#             User.Read.All（名前で検索する場合のみ。無くても動く）
#GRAPH_TENANT_ID=
#GRAPH_CLIENT_ID=
#GRAPH_CLIENT_SECRET=
# 空き時間の照会を行う際に経由するメールボックス（社内の任意の1つ）
#GRAPH_ORGANIZER=
# Windows のタイムゾーン ID。タイ国内は既定値のままでよい。
#GRAPH_TIMEZONE=SE Asia Standard Time

# ===== 予約可能期間（日数）=====
# HR 系部門はより長期の予約が可能
BOOKING_WINDOW_DEFAULT_DAYS=90
BOOKING_WINDOW_HR_DAYS=180
# Departments treated as HR (comma-separated, partial match against src/departments.js)
HR_DEPARTMENTS=GA.HR,HR

# ===== 予約の刻み（分）=====
SLOT_MINUTES=10

# ===== 選択可能な営業時間（24時間表記）=====
# 予約フォームの時刻選択とスケジュール表示の範囲
BUSINESS_START_HOUR=8
BUSINESS_END_HOUR=20
