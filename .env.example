# Copy this file to ".env" and fill in the values.
# ".env" is never committed, because it holds the database password.

# ===== Database (SQL Server) =====
# Connection to the SQL Server instance on the KAGA server.
# Ask the IT department for the server name, database name and account.
# Adjust encrypt / trustServerCertificate to match how certificates are
# handled on the company network.
DATABASE_URL="sqlserver://SERVER:1433;database=MeetingRoomBooking;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true"

# ===== Server =====
PORT=3011
# Read by Express itself. Use "production" on the real server.
NODE_ENV=development
# Enable only when the app is published through a reverse proxy.
# It makes the IP recorded with a booking the user's own rather than the
# proxy's. With no proxy in front, enabling it would let anyone forge that
# IP, so it is off by default.
#TRUST_PROXY=1

# ===== Authentication =====
# mock       : no login. The user types department and name when booking
#              (the browser remembers them).
# checklogin : use the existing company login.
AUTH_MODE=mock

# ===== Outlook calendars (participants' free/busy) =====
# Issued by IT once an app is registered in Azure AD and an administrator has
# consented. Until all four are set, the app shows clearly-labelled sample
# times instead of real calendars.
#   Permission needed: Calendars.Read  (free/busy only, not meeting contents)
#                      User.Read.All   (optional - only to search people by name)
# Run "npm run check:graph" after filling these in; it says what is wrong.
#GRAPH_TENANT_ID=
#GRAPH_CLIENT_ID=
#GRAPH_CLIENT_SECRET=
# Application calls have no "me", so the lookup goes through a named mailbox.
# Any mailbox in the tenant will do.
#GRAPH_ORGANIZER=
# Windows time zone id. Leave as-is for Thailand.
#GRAPH_TIMEZONE=SE Asia Standard Time

# ===== How far ahead a booking may be made (days) =====
# HR departments may book further ahead than everyone else.
BOOKING_WINDOW_DEFAULT_DAYS=90
BOOKING_WINDOW_HR_DAYS=180
# Departments treated as HR (comma-separated, matched against src/departments.js)
HR_DEPARTMENTS=GA.HR,HR

# ===== Booking granularity (minutes) =====
SLOT_MINUTES=10

# ===== Selectable business hours (24-hour clock) =====
# The range offered in the booking form and shown on the schedule.
BUSINESS_START_HOUR=8
BUSINESS_END_HOUR=20
