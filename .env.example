# ===== サーバ設定 =====
PORT=3000
NODE_ENV=development

# ===== データベース =====
# SQLite ファイルの保存先。
# 未指定の場合、アプリは自動的にアプリフォルダの「外」（兄弟フォルダ）に保存する。
#   例: .../meeting-room-booking      ← アプリ本体（更新のたびに丸ごと差し替え）
#       .../meeting-room-booking-data ← データ（自動生成・更新の影響を受けない）
# そのため通常はこの行を設定する必要はない。
# 特定の場所（例: 別ディスクや共有ストレージ）に置きたい場合のみ、
# 絶対パスで明示的に指定すること。
#DB_PATH=/var/lib/meeting-room/booking.db

# ===== バックアップ =====
# npm run backup の出力先と、保持する世代数（古いものから自動削除）
BACKUP_DIR=./backups
BACKUP_KEEP=14

# ===== 認証 =====
# mock      : ログインなし。予約時に部署と氏名を入力する（ブラウザが記憶する）
# checklogin: 既存のログインを利用する
AUTH_MODE=mock

# ===== 予約可能期間（日数）=====
# HR 系部門はより長期の予約が可能
BOOKING_WINDOW_DEFAULT_DAYS=90
BOOKING_WINDOW_HR_DAYS=180
# Department names treated as HR (comma-separated, partial match)
HR_DEPARTMENTS=HR,Human Resources,Recruiting,People,Talent

# ===== 予約の刻み（分）=====
SLOT_MINUTES=10

# ===== 選択可能な営業時間（24時間表記）=====
# 予約フォームの時刻選択とスケジュール表示の範囲
BUSINESS_START_HOUR=8
BUSINESS_END_HOUR=20
